
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String  @id @default(uuid()) @db.Uuid
  email      String   @unique
  username   String   @unique
  password   String
  avatarUrl  String   @default("https://activitymanager-s3-bucket.s3.eu-north-1.amazonaws.com/avatars/Default-user.svg")
  createdAt  DateTime @default(now())

  messages Message[]
  activities Activity[]

  sentRequests     Request[] @relation("SentFriendRequests")
  receivedRequests Request[] @relation("ReceivedFriendRequests")
}

model Message {
  id         String  @id @default(uuid()) @db.Uuid
  body       String
  createdAt  DateTime      @default(now())

  userId String @db.Uuid
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  activityId String @db.Uuid
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String  @id @default(uuid()) @db.Uuid

  messages Message[]
  users User[]
}

model Request {
  id         String        @id @default(uuid()) @db.Uuid
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())

  senderId   String @db.Uuid
  sender     User   @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)

  receiverId String @db.Uuid
  receiver   User   @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

enum RequestStatus {
  PENDING
  ACCEPTED
}